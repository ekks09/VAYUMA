# VAYUMA web-root rules.
# Directory access is restricted with rewrite rules because <Directory> is not
# permitted inside .htaccess files.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:backups|config|lib|database/migrations)(?:/|$) - [F,L,NC]
</IfModule>

# Block access to database migration files
<FilesMatch "\.sql$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Block access to migration runner via web (CLI only)
<Files "run_migration.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</Files>

# Disable directory listing
Options -Indexes
