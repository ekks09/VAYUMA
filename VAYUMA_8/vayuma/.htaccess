# VAYUMA web-root rules.
# Directory access is restricted with rewrite rules because <Directory> is not
# permitted inside .htaccess files.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:backups|config|lib|includes|database)(?:/|$) - [F,L,NC]
</IfModule>

# Block access to database migration files
<FilesMatch "\.sql$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Block access to migration runner via web (CLI only)
<FilesMatch "^(run_migration|test_db)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Disable directory listing
Options -Indexes

# PWA metadata must be served with the correct type and update promptly.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  <Files "manifest.json">
    ForceType application/manifest+json
  </Files>
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|manifest\.(?:webmanifest|json))$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
