# Only explicitly listed browser endpoints are exposed. Each status endpoint
# still enforces its own session and ownership checks in PHP.
<Files *>
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</Files>
<FilesMatch "^(location_options|order_payment_status|subscription_status)\.php$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
  </IfModule>
</FilesMatch>
